{
	// Preferences.sublime-settings -- TeXLib-Installer default editor prefs.
	// Edit freely after install; this file gets overwritten only by re-installs.

	// Pin Ctrl+B to the TeXLib build system. LaTeXTools also ships a
	// "Compile to PDF" build with the same text.tex.latex selector, so leaving
	// this on "Automatic" makes the pick ambiguous -- and only TeXLib's build
	// exposes the Ctrl+Shift+B mode variants (Answer Key / Solutions / ...).
	"build_system": "Packages/User/TeXLib.sublime-build",

	"ignored_packages": ["Vintage"],

	// NOTE: there is deliberately no "update_check" here. v0.7.2 added
	// `"update_check": false` believing it suppressed Sublime's "Update
	// Available" dialog on this pinned portable build. It never did:
	// update_check is a COMMAND (Help -> Check for Updates, defined in
	// Default.sublime-package's Default.sublime-commands and Main.sublime-menu),
	// not a preference. Sublime 4200's own default Preferences documents 196
	// settings keys and update_check is not among them, and unrecognised keys
	// are silently ignored. Verified against the shipped 4200 build in 0.10.1.
	//
	// This Sublime IS a pinned portable copy the installer manages, and taking
	// an in-app update still swaps it for an unmanaged one that no longer
	// matches the manifest -- so update with a new installer release
	// (`install.bat -Update`). We just cannot stop the prompt from a setting.
	// If a real mechanism is ever found, it goes here.

	"font_size": 11,
	"word_wrap": true,
	"index_files": true,
	"highlight_line": true,

	// Auto-complete on backslash inside LaTeX (so typing \begin pops
	// the snippet menu) and on `<` inside HTML/XML.
	"auto_complete_triggers": [
		{ "characters": "<", "selector": "text.html, text.xml" },
		{ "rhs_empty": true, "selector": "punctuation.accessor" },
		{ "characters": "\\", "selector": "text.tex.latex" }
	],

	// Show the entire build panel instead of clipping at the first error.
	"build_panel_word_wrap": true
}
